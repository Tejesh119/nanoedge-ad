  "research_claims_evaluation": {
    "C1": {
      "Claim": "Tiny quantized TCN (~8-12k params, int8) detects anomalies with lower FPR than decision tree and comparable accuracy to fp32 models.",
      "Status": "PARTIALLY SUPPORTED",
      "Evidence": "TCN INT8 has 6,486 parameters and 31.3 KB footprint. INT8 F1 (0.6078) matches FP32 F1 (0.6307, delta 0.0229) with 97.31% agreement. At tuned thresholds, TCN exhibits strong precision (87.6%) and low FPR (0.0845), while Decision Tree achieves higher recall on subtle stuck-at anomalies due to explicit statistical window feature engineering."
    },
    "C2": {
      "Claim": "Dynamic feature (sensor) pruning cuts sensor reads substantially with small F1 loss via gate ranking and runtime wakeup.",
      "Status": "SUPPORTED",
      "Evidence": "Gate-ranked pruning cuts 25% of sensor reads with only 0.0070 F1 drop (from 0.6078 to 0.6008), outperforming Monte Carlo random dropping by +0.0794 F1. Runtime streaming simulation achieved 32.0% sensor read reduction with 31.1% energy savings."
    },
    "C3": {
      "Claim": "The INT8 model fits microcontroller-class budgets (size, params, MACs, latency).",
      "Status": "SUPPORTED",
      "Evidence": "Model size is 31.30 KB (fits in STM32/ESP32 Flash). Analytic MACs: 373,040. Estimated MCU latency is 5.83 ms on Cortex-M4 @80MHz and 1.55 ms on ESP32 @240MHz, well within the 320 ms real-time streaming deadline."
    },
    "C4": {
      "Claim": "The system is robust to noise, sensor dropout and drift.",
      "Status": "SUPPORTED",
      "Evidence": "Robustness sweeps demonstrated graceful degradation across additive noise up to sigma=1.6, sensor dropout up to 50%, and drift offset up to 2.0x std, outperforming unregularized baselines."
    }
  }
